<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="MAIN" Id="{fdd5934c-d734-48ee-b293-0e1806568d30}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	dir : BYTE := 1;
	speed : WORD := 100;
	dummyData AT %Q*: DWORD := SHL(dir,2*8) OR speed ;
	rawAngle AT %I*: DWORD;
	angle: REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[dummyData := SHL(dir,2*8) OR speed ;
angle := (rawAngle/100.0) - 180;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2" Count="0" />
      <LineId Id="12" Count="0" />
      <LineId Id="11" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>