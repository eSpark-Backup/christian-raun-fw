<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="MAIN" Id="{bfe87c1d-4d12-46d6-8ba4-7109b2e0761c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR CONSTANT 
    deviceCount : WORD := 3;
END_VAR

VAR
	{attribute 'TcLinkTo' := '[1].dummyDataOut := TIID^Device_1^Box 1 (sample_app)^Outputs process data mapping^Trigger;
							[1].dummyDataIn := TIID^Device_1^Box 1 (sample_app)^Inputs process data mapping^Counter;
							[2].dummyDataOut := TIID^Device_1^Box 2 (sample_app)^Outputs process data mapping^Trigger;
							[2].dummyDataIn := TIID^Device_1^Box 2 (sample_app)^Inputs process data mapping^Counter;
							[3].dummyDataOut := TIID^Device_1^Box 3 (sample_app)^Outputs process data mapping^Trigger;
							[3].dummyDataIn := TIID^Device_1^Box 3 (sample_app)^Inputs process data mapping^Counter'}
	device : ARRAY [1..deviceCount] OF EthercatDevice ;
	counter: WORD;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FOR counter:=1 TO deviceCount BY 1 DO

    device[counter].dummyDataOut:= SHL(device[counter].dir,2*8) OR device[counter].speed ;

END_FOR;]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="21" Count="3" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>