<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="MAIN" Id="{fdd5934c-d734-48ee-b293-0e1806568d30}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	dirM1 : BYTE := 1;
	speedM1 : WORD := 100;
	dummyDataM1 AT %Q*: DWORD := SHL(dirM1,2*8) OR speedM1 ;
	rawAngleM1 AT %I*: DWORD;
	angleM1: REAL;
	
	dirM2 : BYTE := 1;
	speedM2 : WORD := 100;
	dummyDataM2 AT %Q*: DWORD := SHL(dirM2,2*8) OR speedM2 ;
	rawAngleM2 AT %I*: DWORD;
	angleM2: REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[dummyDataM1 := SHL(dirM1,2*8) OR speedM1 ;
angleM1 := (rawAngleM1/100.0) - 180;
dummyDataM2 := SHL(dirM2,2*8) OR speedM2 ;
angleM2 := (rawAngleM2/100.0) - 180;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2" Count="0" />
      <LineId Id="12" Count="0" />
      <LineId Id="22" Count="0" />
      <LineId Id="21" Count="0" />
      <LineId Id="11" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>