<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="MAIN" Id="{6280d263-c35b-4c3c-89d3-c097ab12dca9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR CONSTANT 
    deviceCount : WORD := 3;
END_VAR

VAR
	// Outputs
	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Speed;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Speed;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Speed'}
	mSpeed AT %Q*: ARRAY [1..deviceCount] OF DWORD ;
	
	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Time;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Time;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Time'}
	mTime AT %Q* : ARRAY [1..deviceCount] OF DWORD ;

	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Direction;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Direction;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Direction'}
	mDirection AT %Q*: ARRAY [1..deviceCount] OF BOOL ;

	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Mode;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Mode;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Outputs process data mapping^Mode'}
	mMode AT %Q*: ARRAY [1..deviceCount] OF BOOL ;

	// Inputs
	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Position;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Position;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Position'}
	mPosition AT %I*: ARRAY [1..deviceCount] OF DWORD ;
	
	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Temperature;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Temperature;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Temperature'}
	mTemperature AT %I* : ARRAY [1..deviceCount] OF DWORD ;

	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag1;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag1;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag1'}
	mDiag1 AT %I*: ARRAY [1..deviceCount] OF DWORD ;
	
	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag2;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag2;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag2'}
	mDiag2 AT %I* : ARRAY [1..deviceCount] OF DWORD ;

	{attribute 'TcLinkTo' := '[1]:= TIID^Device_1^Box 1 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag3;
								[2]	:= TIID^Device_1^Box 2 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag3;
								[3]	:= TIID^Device_1^Box 3 (LAN9255_EtherCAT_Slave)^Inputs process data mapping^Diag3'}
	mDiag3 AT %I*: ARRAY [1..deviceCount] OF DWORD ;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
