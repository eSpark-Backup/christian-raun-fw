<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="MAIN" Id="{ebb70017-f67c-446f-afa8-92dd51f2870a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	dirM1 : BYTE := 1;
	speedM1 : WORD ;
	{attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^Box 1 (sample_app)^Outputs process data mapping^Trigger'}
	dummyDataM1 AT %Q*: DWORD ;
	
	dirM2 : BYTE := 1;
	speedM2 : WORD ;
	{attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^Box 2 (sample_app)^Outputs process data mapping^Trigger'}
	dummyDataM2 AT %Q*: DWORD ;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[dummyDataM1 := SHL(dirM1,2*8) OR speedM1 ;
dummyDataM2 := SHL(dirM2,2*8) OR speedM2 ;]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="7" Count="0" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>